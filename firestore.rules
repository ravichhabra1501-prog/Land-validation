rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health check and connection validation
    match /test/{docId} {
      allow read, write: if true;
    }

    // Digitized land parcels & statutory records
    match /land_records/{recordId} {
      allow read, write: if true;
    }

    // Citizen inquiries, grievance filings, and officer consultation bookings
    match /citizen_appointments/{appointmentId} {
      allow read, write: if true;
    }
  }
}
